PORT=5000
NODE_ENV=development

# ==========================================
# DATABASE CONNECTION
# ==========================================
# Option 1: Free MongoDB Atlas (Cloud - Recommended)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/nivaseva?retryWrites=true&w=majority
#
# Option 2: Local MongoDB Community Server (requires MongoDB installed on your PC)
MONGODB_URI=mongodb://127.0.0.1:27017/nivaseva

# Security
JWT_SECRET=supersecret_nivaseva_jwt_key_2026
CLIENT_URL=http://localhost:5173

# Default First Admin Credentials (Option 1 Seed)
ADMIN_NAME="Rahul Kumar (Admin)"
